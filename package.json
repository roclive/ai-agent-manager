{
  "name": "aam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "aam": "bin/aam"
  },
  "scripts": {
    "aam": "tsx src/cli.ts",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc --noEmit",
    "ui:install": "cd ui && npm install --cache /tmp/aam-npm-cache",
    "ui:build": "cd ui && npm run build",
    "ui:dev": "cd ui && npm run dev"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "better-sqlite3": "^12.0.0",
    "commander": "^14.0.0",
    "croner": "^9.0.0",
    "hono": "^4.9.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
