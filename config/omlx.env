# omlx server defaults for AAM local worker (sourced by scripts/omlx-start.sh). No secrets here.
OMLX_MODEL_NAME=LFM2.5-2.6B-4bit
OMLX_HOST=127.0.0.1
OMLX_PORT=8000
OMLX_CONTEXT_WINDOW=131072
# Dedicated model dir (symlinks only; never weights in git). Existing weights are linked in, not copied.
OMLX_MODEL_DIR="$HOME/.omlx/aam-models"
OMLX_SSD_CACHE_DIR="$HOME/.omlx/aam-ssd-cache"
OMLX_SSD_CACHE_MAX=20GB
# Hard ceiling for omlx = total RAM minus this reserve (GB) for the system.
OMLX_SYSTEM_RESERVE_GB=${OMLX_SYSTEM_RESERVE_GB:-6}
OMLX_MAX_CONCURRENT=${OMLX_MAX_CONCURRENT:-2}
OMLX_IDLE_MINUTES=${OMLX_IDLE_MINUTES:-10}
# Candidate locations of the AAM-39 validated LFM2.5 2.6B MLX 4-bit checkout.
OMLX_WEIGHT_CANDIDATES="$HOME/.omlx/models/LFM2.5-2.6B-4bit $HOME/.cache/huggingface/hub/models--mlx-community--LFM2.5-2.6B-4bit/snapshots/*"
